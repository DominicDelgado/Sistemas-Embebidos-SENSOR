<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_alerta.xml — Pantalla de alerta a pantalla completa

    Estructura:
      - Fondo con gradiente que cambia según el tipo de evento (rojo/naranja/violeta)
      - Dos círculos blancos translúcidos detrás del ícono (animación de ondas)
      - Círculo blanco central con el emoji del evento (animación de latido)
      - Etiqueta "ALERTA DEL SENSOR"
      - Tipo de evento en grande
      - Subtítulo descriptivo
      - Tarjeta con datos: intensidad, hora y aceleración X/Y/Z
      - Botón blanco "DESCARTAR ALERTA"
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_golpe">

    <!-- Onda pulsante 1 (la más grande) -->
    <View
        android:id="@+id/wave1"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/circle_wave"
        android:alpha="0.15"
        app:layout_constraintTop_toTopOf="@id/iconCircle"
        app:layout_constraintBottom_toBottomOf="@id/iconCircle"
        app:layout_constraintStart_toStartOf="@id/iconCircle"
        app:layout_constraintEnd_toEndOf="@id/iconCircle" />

    <!-- Onda pulsante 2 (intermedia) -->
    <View
        android:id="@+id/wave2"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/circle_wave"
        android:alpha="0.25"
        app:layout_constraintTop_toTopOf="@id/iconCircle"
        app:layout_constraintBottom_toBottomOf="@id/iconCircle"
        app:layout_constraintStart_toStartOf="@id/iconCircle"
        app:layout_constraintEnd_toEndOf="@id/iconCircle" />

    <!-- Círculo blanco central con emoji -->
    <FrameLayout
        android:id="@+id/iconCircle"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/circle_white"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="120dp">

        <TextView
            android:id="@+id/tvEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💥"
            android:textSize="90sp"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Badge superior "ALERTA DEL SENSOR" -->
    <TextView
        android:id="@+id/tvAlertaLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨 ALERTA DEL SENSOR"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/badge_bg"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:letterSpacing="0.15"
        app:layout_constraintTop_toBottomOf="@id/iconCircle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <!-- Tipo de evento gigante -->
    <TextView
        android:id="@+id/tvTipoEvento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="GOLPE"
        android:textSize="56sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:textAlignment="center"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.05"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvAlertaLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtítulo descriptivo -->
    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Impacto detectado"
        android:textSize="18sp"
        android:textColor="#FFFFFFCC"
        android:textAlignment="center"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvTipoEvento"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tarjeta con datos del evento -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardDatos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:padding="20dp"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- INTENSIDAD -->
        <TextView
            android:id="@+id/tvIntensidadLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INTENSIDAD"
            android:textSize="11sp"
            android:textColor="#FFFFFF80"
            android:letterSpacing="0.15"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvIntensidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alta"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvIntensidadLabel"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- HORA -->
        <TextView
            android:id="@+id/tvHoraLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HORA"
            android:textSize="11sp"
            android:textColor="#FFFFFF80"
            android:letterSpacing="0.15"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--:--"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvHoraLabel"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Línea divisoria -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#FFFFFF30"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvIntensidad"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ACELERACIÓN (3 ejes en columnas) -->
        <TextView
            android:id="@+id/tvAcelLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACELERACIÓN (G)"
            android:textSize="11sp"
            android:textColor="#FFFFFF80"
            android:letterSpacing="0.15"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvAcelLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF80" />
                <TextView
                    android:id="@+id/tvX"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Y"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF80" />
                <TextView
                    android:id="@+id/tvY"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Z"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF80" />
                <TextView
                    android:id="@+id/tvZ"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Botón DESCARTAR ALERTA -->
    <Button
        android:id="@+id/btnDescartar"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:text="DESCARTAR ALERTA"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:letterSpacing="0.1"
        android:background="@drawable/btn_descartar_bg"
        android:elevation="12dp"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="48dp"
        android:layout_marginHorizontal="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>