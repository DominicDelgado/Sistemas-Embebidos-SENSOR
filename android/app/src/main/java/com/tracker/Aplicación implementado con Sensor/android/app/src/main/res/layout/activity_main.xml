<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml — Pantalla principal de TrackerAlertas

    Contiene:
      - Título y estado de conexión con el backend
      - Token FCM (informativo)
      - Selector de audio de alarma con botones "Escuchar" y "Detener"
      - Botón para disparar una alerta de prueba
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Título de la app -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="🚨 Tracker Alertas"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textAlignment="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <!-- Estado de conexión con el backend -->
        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Conectando con el servidor..."
            android:textSize="16sp"
            android:textAlignment="center"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Token FCM (informativo, recortado) -->
        <TextView
            android:id="@+id/tvToken"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="10sp"
            android:textColor="#666666"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:background="#F0F0F0"
            app:layout_constraintTop_toBottomOf="@id/tvEstado"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Separador -->
        <View
            android:id="@+id/divider1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/tvToken"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ====== SECCIÓN AUDIO ====== -->
        <TextView
            android:id="@+id/tvAudioTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎵 Audio de alarma"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/divider1"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Selector de audio -->
        <Spinner
            android:id="@+id/spinnerAudio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvAudioTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botones Escuchar / Detener -->
        <LinearLayout
            android:id="@+id/llAudioBtns"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/spinnerAudio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btnEscuchar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶ Escuchar"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnDetener"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="■ Detener"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Separador -->
        <View
            android:id="@+id/divider2"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/llAudioBtns"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ====== SECCIÓN TEST ====== -->
        <TextView
            android:id="@+id/tvTestTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧪 Probar alerta"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/divider2"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btnTestPush"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="🚨 Disparar alerta de prueba"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvTestTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Esta app recibirá alertas automáticas cuando el sensor detecte golpes, sacudidas o caídas."
            android:textSize="13sp"
            android:textAlignment="center"
            android:textColor="#666666"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/btnTestPush"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>